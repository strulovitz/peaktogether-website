{
  "schema_version": "1.0",
  "figure_id": "prop_11.f1",
  "node_id": "prop_11",
  "edition": "Newton, Principia, Andrew Motte trans., 1729 (Wikisource); Book I, Section III, Proposition XI; Plate 4, Figure 2.",
  "caption": "If a body revolves in an ellipse, find the law of the centripetal force tending to the focus of the ellipse.",
  "n_steps": 5,
  "steps": [
    {
      "index": 1,
      "gloss": "An ellipse orbit with the force directed to focus S; P is the revolving body."
    },
    {
      "index": 2,
      "gloss": "The construction HI parallel to the tangent gives EP = AC, the semi-major axis."
    },
    {
      "index": 3,
      "gloss": "Conjugate diameters DK and PG, the ordinate Qv, and the parallelogram QxPR."
    },
    {
      "index": 4,
      "gloss": "Lemma XII gives CD to CB; the latus rectum L = 2BC^2/AC enters the ratio chain."
    },
    {
      "index": 5,
      "gloss": "Compounding the ratios yields L*QR / QT^2 = SP^2, so force varies as 1/SP^2."
    }
  ],
